{
  "name": "dsh-yomi-image-mcp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "DSH Yomi GPT Image tools with live API Key settings, no Python required",
  "repository": { "type": "git", "url": "https://github.com/llm-astr/work-contect-gpt2.5.git" },
  "engines": { "node": ">=22" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "image-core.js", "cordis.patch.yml", "README.md", "locale/*.json", "icon.svg"],
  "scripts": { "test": "node --test test-core.js test-client.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"] }
  }
}
